# CyberTrace AI Environment Configuration
PROJECT_NAME="CyberTrace AI"
APP_ENV="prototype"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL="sqlite:///./backend/cybertrace.db"

# Model Hyperparameters
ML_MODEL_TYPE="RandomForestClassifier"
ML_N_ESTIMATORS=100
ML_MAX_DEPTH=6
HIGH_RISK_THRESHOLD=70.0
MEDIUM_RISK_THRESHOLD=40.0

# Law Enforcement Intelligence Context
DEFAULT_JURISDICTION="Bengaluru Metropolitan Police / CID Karnataka"
DEFAULT_OFFICER_ID="demo_officer"
